rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Conta Master: só este e-mail, e só com e-mail verificado (login Google já vem verificado)
    function isMaster() {
      return request.auth != null
        && request.auth.token.email == "kaiovslima@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Save completo de cada jogador: só a própria pessoa lê e escreve
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ficha pública do herói (ranking, torre e PvP): todos logados leem, cada um só escreve a própria
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.size() < 30;
    }

    // Configuração do jogo (eventos, itens, habilidades, missões, imagens): todos leem, só o Master altera
    match /game/{doc} {
      allow read: if true;
      allow write: if isMaster();
    }
  }
}
